# AuthenticationConfiguration (V-14, ADR-035 §2, ADR-015 federation clause).
# k3s does NOT set anonymous-auth when authentication-config is given: it is set here, explicitly.
apiVersion: apiserver.config.k8s.io/v1
kind: AuthenticationConfiguration
anonymous:
  enabled: false
jwt:
  - issuer:
      url: https://token.actions.githubusercontent.com
      audiences:
        - ${oidc_audience}
    claimMappings:
      username:
        expression: "'gha:' + claims.repository"
      groups:
        expression: "['energy-platform:deployers']"
    claimValidationRules:
      - expression: "claims.repository == '${github_repository}'"
        message: "token is not from the energy-platform repository"
      - expression: "claims.ref == 'refs/heads/main'"
        message: "only main may deploy"
